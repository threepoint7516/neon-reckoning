# PUBLIC build-time variable (embedded in the JS bundle — never put secrets here).
# WebSocket URL of your deployed game server. Leave empty to ship a Practice-only build.
# In `npm run dev` the client falls back to ws://<your-host>:2567 automatically.
VITE_GAME_SERVER_URL=wss://your-game-server.example.com
# Optional: an https:// tip page (Ko-fi, Buy Me a Coffee…) shown as "Support the game"
# on your own site only (never in portal builds). Public, so no secrets.
VITE_SUPPORT_URL=
