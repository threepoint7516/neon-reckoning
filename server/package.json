{
  "name": "@neon/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Authoritative WebSocket game server for NEON RECKONING.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --external:ws --sourcemap",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0"
  }
}
