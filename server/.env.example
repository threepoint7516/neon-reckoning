# Server-only configuration (read from the process environment).
PORT=2567
HOST=0.0.0.0
# Comma-separated browser origins allowed to open WebSockets, e.g. your Netlify site.
ALLOWED_ORIGINS=https://your-site.netlify.app
# Optional limits.
MAX_ROOMS=40
MAX_SESSIONS=400
# Seconds a queued party waits before labelled AI fill (only if the party allows bots).
AI_FILL_WAIT=20
LOG_LEVEL=info
NODE_ENV=production
